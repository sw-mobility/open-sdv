{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog.example.org/schemas/organization.schema.json",
  "title": "SDV Open Source Catalog Organization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slug", "name", "short_name", "description"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 2 },
    "short_name": { "type": "string", "minLength": 2, "maxLength": 16 },
    "description": { "type": "string", "minLength": 20, "maxLength": 240 },
    "website": { "type": "string", "format": "uri" },
    "github": { "type": "string", "format": "uri" },
    "country": { "type": "string", "minLength": 2 },
    "demo": { "type": "boolean" }
  }
}
