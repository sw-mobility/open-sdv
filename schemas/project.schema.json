{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catalog.example.org/schemas/project.schema.json",
  "title": "SDV Open Source Catalog Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "schema_version",
    "slug",
    "name",
    "organization",
    "summary",
    "status",
    "license",
    "categories",
    "sdv_layers",
    "maintainers",
    "last_reviewed"
  ],
  "properties": {
    "body": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "organization": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "summary": { "type": "string", "anyOf": [{ "maxLength": 0 }, { "minLength": 30, "maxLength": 260 }] },
    "repository": { "type": "string", "format": "uri" },
    "homepage": { "type": "string", "format": "uri" },
    "documentation": { "type": "string", "format": "uri" },
    "repository_status": { "enum": ["public", "private", "unconfirmed"] },
    "status": { "enum": ["unknown", "active", "maintained", "experimental", "archived"] },
    "license": { "type": "string", "anyOf": [{ "maxLength": 0 }, { "minLength": 2 }] },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "sdv_layers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["vehicle", "edge", "cloud", "tooling", "data", "safety"] }
    },
    "integrates_with": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "technologies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "github": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "last_reviewed": { "type": "string", "format": "date" },
    "featured": { "type": "boolean" },
    "demo": { "type": "boolean" }
  }
}
